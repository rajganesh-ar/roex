# Database (PostgreSQL via Railway or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/roex

# Payload CMS secret — generate a strong random string (min 32 chars)
PAYLOAD_SECRET=your-strong-secret-here

# Public server URL (used for Payload admin / media URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (optional — for contact form / enquiry emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
